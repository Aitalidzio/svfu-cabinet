# Copy to .env.deploy (gitignored via .env*) and fill before:
#   docker compose --env-file .env.deploy up -d --build
# Never commit real values.

POSTGRES_PASSWORD=change-me-long-random
SEED_DEMO_PASSWORD=change-me-demo-password
# Host port on 127.0.0.1 only (see docker-compose.yml). Caddy → this port.
PUBLISH_PORT=3000

# Uncomment only for local Docker over http://localhost (not on the real site):
# COOKIE_SECURE=0
