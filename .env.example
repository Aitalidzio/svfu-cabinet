# Copy to .env.local and fill in. Real values never go into git.

# PostgreSQL connection string for the server (production).
# Leave empty locally: the app then uses PGlite — Postgres inside Node.js, stored in .data/pglite.
DATABASE_URL=

# Password for the demo accounts created by `npm run db:setup`.
# If empty, the script generates a random one and prints it once.
SEED_DEMO_PASSWORD=
